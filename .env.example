# 이 파일을 복사해 `.env` 로 만들고 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# SEC EDGAR 호출 식별용입니다. 가능하면 본인 이메일을 넣으세요.
SEC_USER_AGENT=stock-ai-research your-email@example.com

# 선택: Finnhub 무료 키가 있으면 yfinance 뉴스에 회사 뉴스 헤드라인을 보강합니다.
FINNHUB_API_KEY=

# 선택: --finbert 사용 시 모델 이름. 기본값 그대로 두면 됩니다.
FINBERT_MODEL=ProsusAI/finbert

# 데이터 캐시 / 리포트 저장 폴더 (기본값 사용 권장)
DATA_CACHE_DIR=data_cache
REPORTS_DIR=reports
